{
  "name": "vanishing-frequencies",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local interactive documentary foundation with validated scientific data.",
  "scripts": {
    "data:build": ".venv/bin/python -m scripts.data.pipeline",
    "data:validate": "node --import tsx scripts/data/validate-export.ts data/processed/biodiversity.json",
    "test:data": ".venv/bin/python -m pytest tests/data -q",
    "test:contracts": "node --import tsx tests/data/contracts.test.ts",
    "data:validate-species": "node --import tsx scripts/validate-species.ts",
    "test:species": "node --import tsx --test tests/species-foundation.test.ts",
    "test": "npm run test:data && npm run test:contracts && npm run test:species",
    "typecheck": "tsc --noEmit",
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "test:foundation": "node --import tsx --test tests/foundation/*.test.ts",
    "test:browser": "playwright test",
    "test:local": "npm run typecheck && npm test && npm run test:foundation",
    "check:dependencies": "npm ls --all"
  },
  "dependencies": {
    "zod": "4.6.5",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "gsap": "3.15.0",
    "@gsap/react": "2.1.2",
    "lenis": "1.3.26",
    "three": "0.186.1",
    "@react-three/fiber": "9.8.1",
    "@react-three/drei": "10.7.9",
    "zustand": "5.0.15",
    "d3-scale": "4.0.2",
    "d3-array": "3.2.4",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "tailwindcss": "4.3.3",
    "@tailwindcss/postcss": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@types/d3-scale": "4.0.9",
    "@types/d3-array": "3.2.2",
    "@playwright/test": "1.64.0"
  },
  "engines": {
    "node": ">=24.21.0 <25",
    "npm": ">=11"
  }
}
